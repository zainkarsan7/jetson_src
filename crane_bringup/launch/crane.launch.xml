<launch>
    <let name="hook_urdf_path" value="$(find-pkg-share crane_description)/urdf/hook.urdf.xacro"/>
    <let name="trolley_urdf_path" value="$(find-pkg-share crane_description)/urdf/trolley.urdf.xacro"/>
    <let name="spreader_urdf_path" value="$(find-pkg-share crane_description)/urdf/spreader.urdf.xacro"/>
    <let name="control_urdf_path" value="$(find-pkg-share crane_description)/urdf/crane_control.urdf.xacro"/>

    <let name="rviz_config_path" value="$(find-pkg-share crane_description)/rviz/urdf_config.rviz"/>
        
    <node pkg="robot_state_publisher" exec="robot_state_publisher" name="hook_state_publisher">
        <param name="robot_description"
                value="$(command 'xacro $(var hook_urdf_path)')" />
        <remap from="/robot_description" to="/hook/robot_description"/>
    </node>

    <node pkg="robot_state_publisher" exec="robot_state_publisher" name="trolley_state_publisher">
        <param name="robot_description"
                value="$(command 'xacro $(var trolley_urdf_path)')" />
        <remap from="/robot_description" to="/trolley/robot_description"/>
    </node>

    <node pkg="robot_state_publisher" exec="robot_state_publisher" name="spreader_state_publisher">
        <param name="robot_description"
                value="$(command 'xacro $(var spreader_urdf_path)')" />
        <remap from="/robot_description" to="/spreader/robot_description"/>
    </node>

    <node pkg="robot_state_publisher" exec="robot_state_publisher" name="control_description_publisher">
        <param name="robot_description"
                value="$(command 'xacro $(var control_urdf_path)')" />
        <remap from="/robot_description" to="/control_robot_description"/>
    </node>

    <node pkg="controller_manager" exec="ros2_control_node">
        <param from="$(find-pkg-share crane_bringup)/config/crane_controllers.yaml"/>
        <remap from="~/robot_description" to="/control_robot_description"/>
    </node>


    <node pkg="controller_manager" exec="spawner" args="joint_state_broadcaster"/>
    <node pkg="controller_manager" exec="spawner" args="crane_homing_controller"/>
    <node pkg="controller_manager" exec="spawner" args="crane_attitude_controller"/>

    <node pkg="controller_manager" exec="spawner" args="joint_position_controller"/>
    <node pkg="controller_manager" exec="spawner" args="swivel_position_controller --inactive"/>
    <node pkg="rviz2" exec="rviz2" output="screen" args= "-d $(var rviz_config_path)"/>
</launch>

