<launch>
    <include file="$(find-pkg-share realsense2_camera)/launch/rs_launch.py">
    <arg name="camera_name" value="Crane_RS"/>
    <arg name="camera_namespace" value="Cam_RS"/>
    <arg name="enable_gyro" value="true"/>
    <arg name="enable_accel" value="true"/>
    <arg name="unite_imu_method" value="true"/>
    <arg name="base_frame_id" value="spreader_link"/>
    </include>
    <include file="$(find-pkg-share crane_cam)/launch/crane_cam_launch.xml"/>
    <include file="$(find-pkg-share crane_bringup)/launch/crane.launch.xml"/>

    <include file="$(find-pkg-share foxglove_bridge)/launch/foxglove_bridge_launch.xml">
    <arg name="remote_access" value="true"/>
    <arg name="device_token" value=""/>
    </include>

</launch>