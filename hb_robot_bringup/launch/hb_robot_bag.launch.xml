<?xml version="1.0"?>


<launch>
    <executable cmd = "ros2 bag record 
    --include-unpublished-topics 
    --storage mcap
    --qos-profile-overrides-path $(find-pkg-share hb_robot_bringup)/config/bag_params.yaml
    /tf
    /tf_static
    /joint_states
    /robot_description
    /robot_description_semantic
    /display_planned_path
    /monitored_planning_scene
    /collision_object
    /motion_plan_request
    /scene_cloud
    /profile_inspection/matches
    /profile_inspection/coverage
    /attached_collision_cloud
    /cut_profile/cut_plan
    /cut_profile/debug_collision
    /cut_profile/debug_robot
    /cut_profile/torch_status
    /inspection_viewpoints
    /profile_inspection/camera_poses
    /profile_inspection/scene_cloud
    /profile_inspection/metrics/coverage
    /profile_inspection/metrics/inlier_fraction
    /profile_inspection/metrics/rms_mm
    /platform/imu/metrics
    /platform/imu/filtered
    /k4a/imu
    /hb_robot_lidar/imu
    /hb_robot_lidar/cloud 
    /mpu6050/imu
    /task_state
    /platform_supervision
    "
    output="screen" 
    shell = "true"/>

</launch>