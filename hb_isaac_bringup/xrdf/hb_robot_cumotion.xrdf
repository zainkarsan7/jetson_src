format: xrdf
format_version: 1.0

modifiers:
  - set_base_frame: "world"

default_joint_positions:
  ur10e_shoulder_pan_joint: -1.65
  ur10e_shoulder_lift_joint: -3.0
  ur10e_elbow_joint: 1.8
  ur10e_wrist_1_joint: -0.1
  ur10e_wrist_2_joint: 2.1
  ur10e_wrist_3_joint: -1.2

cspace:
  joint_names:
    - "ur10e_shoulder_pan_joint"
    - "ur10e_shoulder_lift_joint"
    - "ur10e_elbow_joint"
    - "ur10e_wrist_1_joint"
    - "ur10e_wrist_2_joint"
    - "ur10e_wrist_3_joint"
  acceleration_limits: [12.0, 12.0, 12.0, 12.0, 12.0, 12.0]
  jerk_limits: [500.0, 500.0, 500.0, 500.0, 500.0, 500.0]

tool_frames: ["ur10e_torch_link"]

collision:
  geometry: "ur10e_collision_spheres"
  buffer_distance:
    ur10e_shoulder_link: 0.01
    ur10e_upper_arm_link: 0.01
    ur10e_forearm_link: 0.01
    ur10e_wrist_1_link: 0.01
    ur10e_wrist_2_link: 0.01
    ur10e_wrist_3_link: 0.01
    ur10e_bracket_link: 0.01
    ur10e_torch_link: 0.01

self_collision:
  geometry: "ur10e_collision_spheres"
  buffer_distance:
    ur10e_shoulder_link: 0.07
    ur10e_torch_link: 0.05
  ignore:
    robot_mount: ["ur10e_shoulder_link"]
    ur10e_upper_arm_link: ["ur10e_forearm_link", "ur10e_shoulder_link"]
    ur10e_forearm_link: ["ur10e_wrist_1_link"]
    ur10e_wrist_1_link: ["ur10e_wrist_2_link","ur10e_wrist_3_link"]
    ur10e_wrist_2_link: ["ur10e_wrist_3_link", "ur10e_tool0"]
    ur10e_wrist_3_link: ["ur10e_tool0","ur10e_bracket_link"]
    ur10e_bracket_link: ["ur10e_torch_link"]

geometry:
  ur10e_collision_spheres:
    spheres:
      robot_mount:
        - center: [0, 0.74, 0.278]
          radius: 0.75
        - center: [0, 0.74,-0.269]
          radius: 0.75
      ur10e_shoulder_link:
        - center: [0, 0, 0]
          radius: 0.05
      ur10e_upper_arm_link:
        - center: [-0, -0, 0.18]
          radius: 0.09
        - center: [-0.102167, 0,  0.18]
          radius: 0.05
        - center: [-0.204333, 0, 0.18]
          radius: 0.05
        - center: [-0.3065, 0, 0.18]
          radius: 0.05
        - center: [-0.408667, 0, 0.18]
          radius: 0.05
        - center: [-0.510833, 0, 0.18]
          radius: 0.05
        - center: [-0.613, 0,0.18]
          radius: 0.07
      ur10e_forearm_link:
        - center: [-0, 0, 0.03]
          radius: 0.05
        - center: [-0.0951667, 0, 0.03]
          radius: 0.05
        - center: [-0.190333, 0, 0.03]
          radius: 0.05
        - center: [-0.2855, 0, 0.03]
          radius: 0.05
        - center: [-0.380667, 0,0.03]
          radius: 0.05
        - center: [-0.475833, 0,0.03]
          radius: 0.05
        - center: [-0.571, -1.19904e-17, 0.03]
          radius: 0.05
      ur10e_wrist_1_link:
        - center: [0, 0, 0]
          radius: 0.05
      ur10e_wrist_2_link:
        - center: [0, 0, 0]
          radius: 0.05
      ur10e_wrist_3_link:
        - center: [0, 0, 0]
          radius: 0.05
        - center: [0, 0, 0.06]
          radius: 0.07
      ur10e_bracket_link:
        - center: [0.03, -0.023, 0.085]
          radius: 0.113
        - center: [0.02, 0.065, 0.193]
          radius: 0.035
        - center: [0.02, 0.112, 0.240]
          radius: 0.035
        - center: [-0.02, 0.157, 0.290]
          radius: 0.068
        - center: [-0.02, 0.199, 0.255]
          radius: 0.068
      ur10e_torch_link:
        - center: [0, 0, 0.012]
          radius: 0.012
        - center: [0, 0, 0.036]
          radius: 0.012
        - center: [0, 0, 0.064]
          radius: 0.012
