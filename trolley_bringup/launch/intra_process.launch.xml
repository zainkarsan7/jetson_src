<launch>
    <arg name="record" default="false"/>

    

<node_container
    pkg="rclcpp_components"
    exec="component_container_mt"
    name="trolley_container"
    namespace=""
>
<composable_node
pkg="realsense2_camera"
plugin="realsense2_camera::RealSenseNodeFactory"
name="Trolley_Cam"
namespace="Trolley_RS">
<param name="enable_gyro" value="true"/>
<param name="enable_depth" value = "false"/>
<param name="enable_accel" value="true"/>
<param name="unite_imu_method" value="2"/>
<param name="align_depth.enable" value="false"/>
<param name="pointcloud.enable" value="false"/>
<param name="enable_infra" value="false"/>
<param name="enable_infra1" value="false"/>
<param name="enable_infra2" value="false"/>

<param name="initial_reset" value="true"/>
<param name="rgb_camera.color_profile" value = "640x480x15"/>
<extra_arg name="use_intra_process_comms" value="true"/>
</composable_node>

<composable_node
pkg="trolley_cam"
plugin="trolley_cam::SpreaderPoseNode"
name="spreader_pose_node">
<extra_arg name="use_intra_process_comms" value="true"/>
</composable_node>
</node_container>


<executable
            if="$(var record)"
            cmd="bash -c 'cd ~/bags &amp;&amp;
            ros2 bag record 
            /tf2
            /Trolley_RS/Trolley_Cam/imu
            /Trolley/left_spreader_transform
            /Trolley/right_spreader_transform'"
            output="screen"/>



</launch>