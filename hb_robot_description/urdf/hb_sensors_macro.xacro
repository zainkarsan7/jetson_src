<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:macro name="hb_sensors" params="ur_type">
<xacro:include filename="$(find azure_kinect_ros2_driver)/urdf/azure_kinect.urdf.xacro"/>
