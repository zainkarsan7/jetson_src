<root main_tree_to_execute="MainTree">
  <!-- The server's supervision callback requests OFF/stop independently of ticks.
       The fallback below handles containment outcomes, never automatic resumption. -->
  <BehaviorTree ID="MainTree">
    <Fallback>
      <ReactiveSequence>
        <Inverter>
          <FaultActive />
        </Inverter>
        <Sequence>
          <Fallback>
            <ReferenceExists />
            <Sequence>
              <InspectProfile />
              <AwaitPlanningReference />
            </Sequence>
          </Fallback>
          <PlanCut />
          <!-- A candidate survives a supervision gap. Confirm the current pose before motion. -->
          <WorkpiecePoseValid />
          <ValidateTaskState />
          <ExecuteCut />
          <InspectKerf />
          <ValidateKerf />
          <Fallback>
            <KerfVerified />
            <Sequence>
              <ResidualDetected />
              <WorkpiecePoseValid />
              <PlanRecut />
              <WorkpiecePoseValid />
              <ValidateTaskState />
              <ExecuteRecut />
              <InspectKerf />
              <ValidateKerf />
              <KerfVerified />
            </Sequence>
          </Fallback>
        </Sequence>
      </ReactiveSequence>
      <Sequence>
        <Escape />
        <AlwaysFailure />
      </Sequence>
    </Fallback>
  </BehaviorTree>
  <TreeNodesModel>
    <Condition ID="FaultActive" />
    <Condition ID="ReferenceExists" />
    <Condition ID="WorkpiecePoseValid" />
    <Condition ID="ValidateTaskState" />
    <Condition ID="KerfVerified" />
    <Condition ID="ResidualDetected" />
    <Condition ID="ValidateKerf" />
    <Action ID="InspectProfile" />
    <Action ID="AwaitPlanningReference" />
    <Action ID="PlanCut" />
    <Action ID="ExecuteCut" />
    <Action ID="InspectKerf" />
    <Action ID="PlanRecut" />
    <Action ID="ExecuteRecut" />
    <Action ID="Escape" />
  </TreeNodesModel>
</root>
