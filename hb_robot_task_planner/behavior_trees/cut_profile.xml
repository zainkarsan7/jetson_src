<root main_tree_to_execute="MainTree">
    <BehaviorTree ID="MainTree">
    <Sequence name="InspectAndPlan">
    <InspectProfile
     max_views = "10"     
     samples_per_view = "3"
     depth_range = "0.75"   
     camera_standoff = "0.4"
     rms_error = "{profile_rms}"
     inlier_fraction = "{profile_inlier}"
     coverage = "{profile_coverage}"
     rms_max = "0.01"
     inlier_min = "0.4"
     coverage_min = "0.3"
     />
    
    <ProfileValid
        rms_error = "{profile_rms}"
        inlier_fraction = "{profile_inlier}"
        coverage = "{profile_coverage}"
        rms_max = "0.01"
        inlier_min = "0.4"
        coverage_min = "0.3"
    />


    <CutProfile 
        standoff = "0.01"
        ang_tol = "0.3"
        pos_tol = "0.01"/>
    </Sequence>
    </BehaviorTree>
</root>