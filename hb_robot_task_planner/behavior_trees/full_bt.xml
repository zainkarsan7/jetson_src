<root main_tree_to_execute="MainTree">
  <!-- The server's supervision callback requests OFF/stop independently of ticks.
       The fallback below handles containment outcomes, never automatic resumption. -->
  <BehaviorTree ID="MainTree">
    <Fallback>
      <ReactiveSequence>
        <Inverter><FaultActive/></Inverter>
        <Sequence>
          <Fallback>
            <ReferenceExists/>
            <Sequence><Inverter><ReferenceExists/></Inverter><InspectProfile/><AwaitPlanningReference/></Sequence>
          </Fallback>
          <CaptureCutEnvironment/>
          <PlanCut/>
          <!-- A candidate survives a supervision gap. Confirm the current pose before motion. -->
          <SubTree ID="EnsureGeometryValid"/>
          <ValidateTaskState/>
          <ExecuteCut/>
          <SubTree ID="EnsureSeparationVerified"/>
        </Sequence>
      </ReactiveSequence>
      <Sequence><Escape/><AlwaysFailure/></Sequence>
    </Fallback>
  </BehaviorTree>
  <BehaviorTree ID="EnsureGeometryValid">
    <Fallback>
      <WorkpiecePoseValid/>
      <Sequence><RevalidateWorkpiece/><AwaitGeometry/></Sequence>
    </Fallback>
  </BehaviorTree>
  <BehaviorTree ID="ObserveAndEvaluate">
    <Sequence><InspectKerf/><ValidateKerf/></Sequence>
  </BehaviorTree>
  <BehaviorTree ID="EnsureSeparationVerified">
    <Sequence>
      <SubTree ID="ObserveAndEvaluate"/>
      <Fallback>
        <KerfVerified/>
        <Sequence>
          <KerfInconclusive/>
          <SubTree ID="ObserveAndEvaluate"/>
          <KerfVerified/>
        </Sequence>
        <Sequence>
          <ResidualDetected/>
          <SubTree ID="EnsureGeometryValid"/>
          <CaptureCutEnvironment/>
          <PlanRecut/>
          <SubTree ID="EnsureGeometryValid"/>
          <ValidateTaskState/>
          <ExecuteRecut/>
          <SubTree ID="ObserveAndEvaluate"/>
          <KerfVerified/>
        </Sequence>
      </Fallback>
    </Sequence>
  </BehaviorTree>
  <TreeNodesModel>
        <Action ID="CaptureCutEnvironment"/>
    <Condition ID="FaultActive"/>
    <Condition ID="ReferenceExists"/>
    <Condition ID="WorkpiecePoseValid"/>
    <Condition ID="ValidateTaskState"/>
    <Condition ID="KerfVerified"/>
    <Condition ID="KerfInconclusive"/>
    <Condition ID="ResidualDetected"/>
    <Condition ID="ValidateKerf"/>

    <Action ID="InspectProfile"/>
    <Action ID="AwaitPlanningReference"/>
    <Action ID="AwaitGeometry"/>
    <Action ID="RevalidateWorkpiece"/>
    <Action ID="PlanCut"/>
    <Action ID="ExecuteCut"/>
    <Action ID="InspectKerf"/>
    <Action ID="PlanRecut"/>
    <Action ID="ExecuteRecut"/>
    <Action ID="Escape"/>
  </TreeNodesModel>

</root>
