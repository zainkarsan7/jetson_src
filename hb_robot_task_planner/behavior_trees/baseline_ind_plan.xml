<?xml version="1.0"?>
<root main_tree_to_execute="IndependentCuts" BTCPP_format="3">
  <BehaviorTree ID="IndependentCuts">
    <!-- Session runner pauses without halting this checkpoint on failure. -->
    <SequenceStar name="IndependentCutSession">
      <InspectProfile/>
      <AwaitPlanningReference/>
      <Fallback>
        <WorkpiecePoseValid/>
        <SequenceStar>
          <WaitForStablePlatform/>
          <RevalidateWorkpiece/>
          <AwaitGeometry/>
        </SequenceStar>
      </Fallback>
      <CaptureCutEnvironment/>
      <PlanCut/>
      <ForEachPending>
        <SequenceStar name="ExecuteOneFeature">
          <SelectNextCutFeature/>
          <AwaitExecutionReady/>
          <ExecuteCut/>
        </SequenceStar>
      </ForEachPending>
      <!-- Rejected/unplannable/interrupted features never imply completed cuts. -->
      <AllCutFeaturesCompleted/>
    </SequenceStar>
  </BehaviorTree>
</root>