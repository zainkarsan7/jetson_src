# Result
bool success

uint8 SUCCESS=0
uint8 INSUFFICIENT_GEOMETRY=1
uint8 MOTION_FAILED=2
uint8 NO_REACHABLE_VIEW=3
uint8 ACQUISITION_FAILED=4
uint8 PLANNING_FAILED=5
