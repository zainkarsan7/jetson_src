<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="crane_ros2_control" params="use_mock_hardware">

    <ros2_control name="CraneHardwareInterface" type="system">

      <xacro:if value="${use_mock_hardware}">
        <hardware>
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </hardware>
      </xacro:if>

      <hardware>
        <plugin>crane_hardware/CraneHardware</plugin>
        <param name="port">/dev/ttyACM1</param>
        <param name="baud_rate">115200</param>
    
        <param name="swivel_steps_per_unit">1000.0</param>
        <param name="left_steps_per_unit">1000.0</param>
        <param name="right_steps_per_unit">1000.0</param>
      </hardware>
      
      <gpio name="crane">
        <command_interface name="home"/>
        <state_interface name="homing"/>
        <state_interface name="homed"/>
        <state_interface name="home_failed"/>
      </gpio>

      <joint name="swivel_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
      </joint>


      <joint name="LG_lin_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
      </joint>

      <joint name="RG_lin_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
      </joint>
<!-- 
      <joint name="swivel_joint">
        <command_interface name="velocity"/>
        <command_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="position"/>
      </joint>
      <joint name="LG_lin_joint">
        <command_interface name="velocity"/>
        <command_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="position"/>
      </joint>
      <joint name="RG_lin_joint">
        <command_interface name="velocity"/>
        <command_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="position"/>
      </joint> -->
    </ros2_control>
  </xacro:macro>
</robot>